{
  "name": "@openvidstudio/mcp-server",
  "version": "1.3.1",
  "description": "MCP server for openvidstudio: plan, capture, narrate, score, render and finalize a video of your real product, driven by an AI coding agent.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "bin": {
    "openvidstudio-mcp": "dist/stdio.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "templates",
    "docs",
    "py"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openvidstudio/capture": "workspace:*",
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "node scripts/copy-template.mjs && node scripts/copy-docs.mjs && tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/manual-test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnayDhawan/openvidstudio.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/AnayDhawan/openvidstudio#readme",
  "bugs": {
    "url": "https://github.com/AnayDhawan/openvidstudio/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remotion",
    "playwright",
    "video",
    "demo-video",
    "claude"
  ]
}
