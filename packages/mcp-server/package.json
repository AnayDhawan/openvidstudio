{
  "name": "@openvidstudio/mcp-server",
  "version": "0.2.0",
  "description": "MCP server exposing openvidstudio's mechanical pipeline tools: project scaffolding, beats validation, scene stubs, composition stitching, render, QC frame extraction, and zoom-compensated screenshot/screen-recording capture.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "openvidstudio-mcp": "dist/stdio.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "templates",
    "docs"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "node scripts/copy-template.mjs && node scripts/copy-docs.mjs && tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/manual-test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnayDhawan/openvidstudio.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/AnayDhawan/openvidstudio#readme",
  "bugs": {
    "url": "https://github.com/AnayDhawan/openvidstudio/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remotion",
    "playwright",
    "video",
    "demo-video",
    "claude"
  ]
}
